# Copie este arquivo para ".env" e preencha com seus dados reais.
# O arquivo .env NUNCA deve ser compartilhado ou subido pro GitHub.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=barbearia

